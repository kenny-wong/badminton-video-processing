{
  "name": "badminton-video",
  "productName": "Badminton Video",
  "version": "1.71.0",
  "private": true,
  "description": "Desktop app that links phone videos of badminton matches to Badminton England's tournament records, tags rallies, burns in the score, cuts the gaps between rallies and names the result for YouTube.",
  "author": "Kenny Wong",
  "license": "MIT",
  "repository": "github:kenny-wong/badminton-video-processing",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js --open",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.js\"",
    "app": "electron .",
    "dist": "node scripts/make-icon.mjs && node scripts/bundle-ffmpeg.mjs && electron-builder --win nsis",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.kenny-wong.badminton-video",
    "productName": "Badminton Video",
    "copyright": "Copyright © 2026 Kenny Wong",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.js",
      "electron/**",
      "api/**",
      "lib/**",
      "migrations/**",
      "public/**",
      "!public/visual-kit/*.txt",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Badminton Video",
      "artifactName": "Badminton-Video-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
